# Production settings for the Laravel containers (docker-compose.prod.yml). On the server this is
# /www/wwwroot/majidf.ca/.env.production, mode 600. Generate APP_KEY with:
#   echo "base64:$(openssl rand -base64 32)"

APP_NAME="Majid Farzaneh"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://majidf.ca
APP_TIMEZONE=America/Toronto
FRONTEND_URL=https://majidf.ca
PORTAL_URL=https://panel.majidf.ca
ADMIN_URL=https://admin.majidf.ca
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
# The stack's own MySQL 8.4 container (host networking, 127.0.0.1:3307). Its data lives in the
# mysql_data volume; these values create the database and user on its first start.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=majidf_db
DB_USERNAME=majidf_db_user
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-too

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6394
REDIS_PASSWORD=change-me-redis

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Shared across the site, panel. and admin. subdomains.
SESSION_DOMAIN=.majidf.ca
SANCTUM_STATEFUL_DOMAINS=majidf.ca,panel.majidf.ca,admin.majidf.ca
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Any SMTP provider (Postmark, Mailgun, SES, Gmail…)
MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@majidf.ca"
MAIL_FROM_NAME="Majid Farzaneh"

ADMIN_EMAIL=majix.fa@gmail.com
ADMIN_NAME="Majid Farzaneh"
BUSINESS_NAME="Majid Farzaneh"
BUSINESS_EMAIL=majix.fa@gmail.com
BUSINESS_PHONE=647-271-4449
BUSINESS_ADDRESS="Toronto, ON, Canada"
BUSINESS_TAX_NUMBER=
INVOICE_TAX_LABEL=HST
INVOICE_TAX_RATE=13
INVOICE_TERMS_DAYS=14

# Live keys from https://dashboard.stripe.com/apikeys
# Webhook endpoint: https://<DOMAIN>/api/stripe/webhook with events
#   payment_intent.succeeded, payment_intent.payment_failed, checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Offline payments shown to clients (e-Transfer, bank transfer, cheque). Bank transfer appears only when PAY_BANK_DETAILS is set.
PAY_ETRANSFER_EMAIL=majix.fa@gmail.com
PAY_ETRANSFER_AUTODEPOSIT=true
PAY_CHEQUE_PAYABLE_TO="Majid Farzaneh"
PAY_CHEQUE_MAIL_TO="Toronto, ON, Canada"
PAY_BANK_DETAILS=
