# Local development inside Docker (docker compose up). Copy to .env and run `php artisan key:generate`.
APP_NAME="Majid Farzaneh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://majidf.local
APP_TIMEZONE=America/Toronto
# The three local sites (add them to /etc/hosts, see README).
FRONTEND_URL=http://majidf.local
PORTAL_URL=http://panel.majidf.local
ADMIN_URL=http://admin.majidf.local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=portal
DB_USERNAME=portal
DB_PASSWORD=portal

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# One sign-in shared by majidf.local, panel.majidf.local and admin.majidf.local.
SESSION_DOMAIN=.majidf.local
SANCTUM_STATEFUL_DOMAINS=majidf.local,panel.majidf.local,admin.majidf.local,localhost,127.0.0.1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

# Mailpit catches every email in development: http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@majidfarzaneh.com"
MAIL_FROM_NAME="Majid Farzaneh"

# The super admin account (created by the seeder). Sign in at /portal/login with this email.
ADMIN_EMAIL=majix.fa@gmail.com
ADMIN_NAME="Majid Farzaneh"

BUSINESS_NAME="Majid Farzaneh"
BUSINESS_EMAIL=majix.fa@gmail.com
BUSINESS_PHONE=647-271-4449
BUSINESS_ADDRESS="Toronto, ON, Canada"
BUSINESS_TAX_NUMBER=
INVOICE_TAX_LABEL=HST
INVOICE_TAX_RATE=13
INVOICE_TERMS_DAYS=14

# Offline payments shown to clients (e-Transfer, bank transfer, cheque). Bank transfer appears only when PAY_BANK_DETAILS is set.
PAY_ETRANSFER_EMAIL=majix.fa@gmail.com
PAY_ETRANSFER_AUTODEPOSIT=true
PAY_CHEQUE_PAYABLE_TO="Majid Farzaneh"
PAY_CHEQUE_MAIL_TO="Toronto, ON, Canada"
PAY_BANK_DETAILS="Bank: RBC Royal Bank\nAccount name: Majid Farzaneh\nInstitution: 003\nTransit: 01234\nAccount: 1234567"

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
# With the Stripe CLI service (docker compose --profile stripe up) the webhook secret is printed in its logs.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
